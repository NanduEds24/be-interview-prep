#!/bin/sh
# Fast local check before each commit: formatting of the files you changed (the full checks run in CI).
# Enable once per clone:  git config core.hooksPath .githooks     Skip once:  git commit --no-verify
# Fix problems with:      .\mvnw.cmd spotless:apply
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) mvn=./mvnw.cmd ;;
  *) mvn=./mvnw ;;
esac
if ! "$mvn" -q -B spotless:check; then
  echo "pre-commit: formatting check failed. Run spotless:apply, then git add the files and commit again." >&2
  exit 1
fi
